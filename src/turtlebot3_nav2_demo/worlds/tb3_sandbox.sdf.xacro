<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true"/>
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <xacro:unless value="$(arg headless)">
      <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    </xacro:unless>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <light name="sun" type="directional"><cast_shadows>0</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.8 0.8 0.8 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation><direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane"><static>true</static><link name="ground">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
    </link></model>
    <scene><shadows>false</shadows></scene>
    <physics name="maze_physics" type="ode"><max_step_size>0.003</max_step_size><real_time_factor>1</real_time_factor></physics>
    <!-- Nine 2 m cells with 0.85 m passages; continuous closed perimeter. -->
    <model name="closed_3x3_maze"><static>true</static>
      <link name="outer_west"><pose>-3.0000 0.0000 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 6.1200 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 6.1200 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="outer_east"><pose>3.0000 0.0000 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 6.1200 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 6.1200 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="outer_south"><pose>0.0000 -3.0000 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.1200 0.12 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.1200 0.12 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="outer_north"><pose>0.0000 3.0000 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.1200 0.12 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.1200 0.12 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v-1_0_a"><pose>-1.0000 -2.7125 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v-1_0_b"><pose>-1.0000 -1.2875 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v-1_1_a"><pose>-1.0000 -0.7125 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v-1_1_b"><pose>-1.0000 0.7125 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v-1_2_a"><pose>-1.0000 1.2875 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v-1_2_b"><pose>-1.0000 2.7125 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v+1_0_a"><pose>1.0000 -2.7125 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v+1_0_b"><pose>1.0000 -1.2875 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v+1_1_a"><pose>1.0000 -0.7125 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v+1_1_b"><pose>1.0000 0.7125 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v+1_2_a"><pose>1.0000 1.2875 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="v+1_2_b"><pose>1.0000 2.7125 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.5750 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="h-1_west"><pose>-0.7125 -1.0000 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5750 0.12 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5750 0.12 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="h-1_east"><pose>0.7125 -1.0000 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5750 0.12 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5750 0.12 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="h+1_west"><pose>-0.7125 1.0000 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5750 0.12 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5750 0.12 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
      <link name="h+1_east"><pose>0.7125 1.0000 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5750 0.12 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5750 0.12 0.7</size></box></geometry><material><ambient>0.22 0.25 0.28 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
